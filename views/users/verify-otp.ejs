<% layout("/layouts/boilerplate") %>

<!-- ================================================================
     STAYZEN — OTP VERIFICATION PAGE
     RETRO PAN AM LUGGAGE TAG THEME
     ================================================================ -->
<div class="lug-page">

  <!-- Left Panel -->
  <div class="lug-left" aria-hidden="true">
    <div class="lug-left__text">
      <div class="lug-left__eyebrow">Verification</div>
      <div class="lug-left__big">Verify<br>Email.</div>
      <div class="lug-left__small">We've sent a 6-digit code to your inbox. Enter it below to complete your registration.</div>
    </div>

    <!-- Luggage tag decoration -->
    <div class="lug-left__tag">
      <div class="lug-left__tag-hole"></div>
      <div class="lug-left__tag-string"></div>
    </div>

    <!-- Barcode -->
    <div class="lug-left__barcode">
      <div class="lug-left__bar lug-bar--2"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--3"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--2"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--4"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--2"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--3"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--2"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--4"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--2"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--3"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--2"></div>
      <div class="lug-left__bar lug-bar--1"></div>
      <div class="lug-left__bar lug-bar--4"></div>
    </div>
  </div>

  <!-- Right Panel — Form -->
  <div class="lug-right">
    <div class="lug-card">

      <div class="lug-card__banner lug-card__banner--otp">
        <div class="lug-card__banner-eyebrow">Final Step</div>
        <h1 class="lug-card__banner-title">Verify<br>Email</h1>
        <!-- Luggage tag decoration -->
        <div class="lug-card__tag">
          <div class="lug-card__tag-hole"></div>
          <div class="lug-card__tag-string"></div>
        </div>
      </div>

      <div class="lug-card__body">
        <p class="lug-otp-email-note">A verification code was sent to <strong><%= email %></strong></p>

        <form action="/verify-otp" method="post" class="needs-validation" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="email" value="<%= email %>">

          <div class="lug-field">
            <label for="otp" class="lug-label">
              6-Digit Verification Code
            </label>
            <input
              name="otp"
              id="otp"
              type="text"
              class="lug-input lug-input--otp"
              placeholder="000000"
              required
              maxlength="6"
              pattern="\d{6}"
              inputmode="numeric"
              autocomplete="one-time-code"
            >
            <div class="invalid-feedback">Please enter the 6-digit code.</div>
          </div>

          <button class="lug-submit" type="submit">
            <span class="btn-text">Verify & Create Account</span>
            <i class="fa-solid fa-circle-check ms-2"></i>
          </button>
        </form>

        <div class="lug-switch mt-4">
          Didn't receive a code? 
          <form action="/resend-otp" method="post" class="d-inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="email" value="<%= email %>">
            <button type="submit" class="lug-switch__btn">Resend Code</button>
          </form>
        </div>
        
        <div class="lug-switch mt-2">
            Wrong email? <a href="/signup">Start Over →</a>
        </div>
      </div>

    </div>
  </div>

</div>
