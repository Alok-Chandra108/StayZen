<%- layout("/layouts/boilerplate") -%>
<script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<main class="sz-dashboard">
  <div class="container">
    
    <header class="sz-dashboard__header">
      <h1 class="sz-dashboard__title sz-dashboard__title--flex">
        <i class="fa-solid fa-chart-pie me-3"></i>Host Dashboard
      </h1>
      <div class="sz-badge sz-badge--action">
        <%= listings.length %> Properties
      </div>
    </header>

    <% 
      const q = locals.searchQuery || {}; 
    %>

    <!-- SUMMARY METRICS & FILTERS -->
    <div class="sz-host-summary">
      
      <!-- Earnings Card -->
      <div class="sz-host-earnings">
        <div class="sz-host-earnings__label">Total Revenue</div>
        <div class="sz-host-earnings__val">₹<%= totalEarnings.toLocaleString("en-IN") %></div>
        <% if(q.startDate || q.endDate) { %>
          <div class="sz-host-earnings__badge">Filtered Range</div>
        <% } %>
        <i class="fa-solid fa-chart-line sz-host-earnings__icon"></i>
      </div>

      <!-- Date Filter Form -->
      <div class="sz-host-filter">
        <h3 class="sz-host-filter__title">Filter by Date</h3>
        <form action="/host-dashboard" method="GET" class="sz-host-filter__form">
          <div class="sz-host-filter__row">
            <div class="sz-host-filter__field">
              <label class="sz-host-filter__label">Start</label>
              <input type="date" name="startDate" id="startDate" value="<%= q.startDate || '' %>" class="sz-host-filter__input">
            </div>
            <div class="sz-host-filter__field">
              <label class="sz-host-filter__label">End</label>
              <input type="date" name="endDate" id="endDate" value="<%= q.endDate || '' %>" class="sz-host-filter__input">
            </div>
          </div>
          <div class="sz-host-filter__row sz-host-filter__row--actions">
            <button type="submit" class="sz-btn--action-panam sz-host-filter__btn">Apply</button>
            <a href="/host-dashboard" class="sz-btn--danger-panam sz-host-filter__btn">Reset</a>
          </div>
        </form>
      </div>

    </div>

    <!-- ANALYTICS DASHBOARD -->
    <div class="sz-analytics-grid">
      
      <!-- Yield Trend Chart -->
      <div class="sz-analytics-card">
        <h3 class="sz-analytics-card__title">
          <i class="fa-solid fa-chart-line"></i> Revenue Trend (6 Months)
        </h3>
        <div class="sz-host-chart-container sz-host-chart-container--lg">
          <canvas id="yieldChart"></canvas>
        </div>
      </div>

      <!-- Occupancy & Performance -->
      <div class="sz-host-analytics-side">
        
        <!-- Occupancy Circle -->
        <div class="sz-analytics-card sz-analytics-card--center">
          <h3 class="sz-analytics-card__title sz-analytics-card__title--center">Occupancy Rate</h3>
          <div class="sz-occupancy-circle">
            <span class="sz-occupancy-circle__val"><%= occupancyRate %>%</span>
            <span class="sz-occupancy-circle__label">Occupancy</span>
          </div>
          <p class="sz-host-occupancy-note">Current Month</p>
        </div>

        <!-- Asset Performance Bar -->
        <div class="sz-analytics-card">
          <h3 class="sz-analytics-card__title">Property Performance</h3>
          <div class="sz-host-chart-container sz-host-chart-container--sm">
            <canvas id="assetChart"></canvas>
          </div>
        </div>

      </div>
    </div>

    <!-- UPCOMING RESERVATIONS -->
    <section class="sz-host-section">
      <h2 class="sz-host-section__title">
        <span>Upcoming Bookings</span>
        <span class="sz-badge sz-badge--action"><%= upcomingBookings.length %> Active</span>
      </h2>

      <% if(upcomingBookings.length === 0) { %>
        <div class="sz-dashboard__empty sz-dashboard__empty--compact">
          <i class="fa-solid fa-calendar-day"></i>
          <h2 class="sz-dashboard__empty-title">No upcoming guests</h2>
        </div>
      <% } else { %>
        <div class="sz-host-table-wrap">
          <table class="sz-host-table">
            <thead class="sz-host-table__head">
              <tr>
                <th>Property</th>
                <th>Guest</th>
                <th>Dates</th>
                <th>Total</th>
                <th class="sz-host-table__th--center">Status</th>
              </tr>
            </thead>
            <tbody>
              <% upcomingBookings.forEach((booking) => { %>
                <tr class="sz-host-table__row">
                  <td class="sz-host-table__td--bold">
                    <a href="/listings/<%= booking.listing._id %>" class="sz-host-table__link"><%= booking.listing.title %></a>
                  </td>
                  <td>
                    <div class="sz-host-table__guest"><%= booking.user.username %></div>
                    <div class="sz-host-table__email"><%= booking.user.email %></div>
                  </td>
                  <td>
                    <div class="sz-host-table__dates"><%= booking.checkIn.toLocaleDateString('en-GB') %> → <%= booking.checkOut.toLocaleDateString('en-GB') %></div>
                  </td>
                  <td class="sz-host-table__td--bold">₹<%= booking.totalPrice.toLocaleString("en-IN") %></td>
                  <td class="sz-host-table__td--center">
                    <span class="sz-status-label sz-status-label--confirmed">Confirmed</span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <!-- PAST RESERVATIONS -->
    <section class="sz-host-section">
      <h2 class="sz-host-section__title">Past Bookings</h2>

      <% if(pastBookings.length === 0) { %>
        <div class="sz-host-empty-past">
          <p>No completed bookings yet</p>
        </div>
      <% } else { %>
        <div class="sz-host-table-wrap">
          <table class="sz-host-table">
            <thead class="sz-host-table__head sz-host-table__head--past">
              <tr>
                <th>Property</th>
                <th>Guest</th>
                <th>Dates</th>
                <th class="sz-host-table__th--right">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% pastBookings.forEach((booking) => { %>
                <tr class="sz-host-table__row">
                  <td class="sz-host-table__td--bold"><%= booking.listing.title %></td>
                  <td class="sz-host-table__td--medium"><%= booking.user.username %></td>
                  <td><%= booking.checkIn.toLocaleDateString('en-GB') %> - <%= booking.checkOut.toLocaleDateString('en-GB') %></td>
                  <td class="sz-host-table__td--right sz-host-table__td--bold">₹<%= booking.totalPrice.toLocaleString("en-IN") %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <!-- OWNED PROPERTIES -->
    <section class="sz-host-section">
      <h2 class="sz-host-section__title">My Properties</h2>

      <% if(listings.length === 0) { %>
        <div class="sz-dashboard__empty">
          <i class="fa-solid fa-building"></i>
          <h2 class="sz-dashboard__empty-title">No Properties Listed</h2>
          <a href="/listings/new" class="sz-btn--action-panam sz-host-list-cta">List Your First Property</a>
        </div>
      <% } else { %>
        <div class="sz-host-properties-grid">
          <% listings.forEach((listing) => { %>
            <div class="sz-host-property-card">
              <div class="sz-host-property-card__img">
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
              </div>
              <div class="sz-host-property-card__body">
                <h3 class="sz-host-property-card__title"><%= listing.title %></h3>
                <div class="sz-host-property-card__loc">
                  <i class="fa-solid fa-location-dot"></i> <%= listing.location %>
                </div>
              </div>
              <a href="/listings/<%= listing._id %>" class="sz-host-property-card__cta">
                View Details
              </a>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

  </div>
</main>

<!-- DATA_STORE FOR ANALYTICS -->
<div id="analytics-data" 
     class="sz-hidden"
     data-monthly='<%= JSON.stringify(monthlyYield) %>'
     data-performance='<%= JSON.stringify(listingPerformance) %>'>
</div>

<script nonce="<%= cspNonce %>">
  const dataShell = document.getElementById('analytics-data');
  const monthlyYieldData = JSON.parse(dataShell.getAttribute('data-monthly'));
  const performanceDataRaw = JSON.parse(dataShell.getAttribute('data-performance'));

  const yieldCtx = document.getElementById('yieldChart').getContext('2d');
  const assetCtx = document.getElementById('assetChart').getContext('2d');

  new Chart(yieldCtx, {
    type: 'line',
    data: {
      labels: monthlyYieldData.map(y => y.month),
      datasets: [{
        label: 'Revenue (INR)',
        data: monthlyYieldData.map(y => y.total),
        borderColor: '#1A237E',
        backgroundColor: 'rgba(0, 131, 143, 0.08)',
        borderWidth: 2.5,
        fill: true,
        tension: 0.4,
        pointBackgroundColor: '#FFB300',
        pointBorderColor: '#1A237E',
        pointBorderWidth: 2,
        pointRadius: 5,
        pointHoverRadius: 7
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
          ticks: { font: { weight: '600', size: 11, family: 'Space Grotesk' } }
        },
        x: {
          grid: { display: false },
          ticks: { font: { weight: '600', size: 11, family: 'Space Grotesk' } }
        }
      },
      plugins: { legend: { display: false } }
    }
  });

  new Chart(assetCtx, {
    type: 'bar',
    data: {
      labels: performanceDataRaw.map(p => p.title.length > 15 ? p.title.substring(0,12)+'...' : p.title ),
      datasets: [{
        label: 'Revenue',
        data: performanceDataRaw.map(p => p.yield),
        backgroundColor: '#FFB300',
        borderColor: '#1A237E',
        borderWidth: 1,
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      scales: {
        y: { 
          grid: { display: false },
          ticks: { font: { weight: '600', size: 10, family: 'Space Grotesk' } }
        },
        x: { display: false }
      },
      plugins: { legend: { display: false } }
    }
  });
</script>
