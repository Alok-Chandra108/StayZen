<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your StayZen Account</title>
    <!--[if mso]>
    <style>table,td,div,p,a{font-family:Arial,sans-serif!important}</style>
    <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#00838F;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">

    <!-- Outer wrapper -->
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#00838F;">
        <tr>
            <td align="center" style="padding:40px 20px;">

                <!-- Main card -->
                <table role="presentation" cellpadding="0" cellspacing="0" width="600" style="max-width:600px;background-color:#FAFAFA;border:3px solid #1A237E;border-radius:12px;overflow:hidden;box-shadow:8px 8px 0 #D32F2F;">

                    <!-- ══════ HEADER — NAVY LUGGAGE TAG ══════ -->
                    <tr>
                        <td style="background:linear-gradient(135deg,#00838F 0%,#1A237E 100%);padding:36px 40px;text-align:center;position:relative;">

                            <!-- Luggage tag silhouette (background decoration) -->
                            <table role="presentation" cellpadding="0" cellspacing="0" width="120" align="right" style="margin-top:-10px;">
                                <tr>
                                    <td style="width:120px;height:70px;border:3px solid rgba(255,255,255,0.1);border-radius:10px;position:relative;">
                                        <!-- Hole -->
                                        <table role="presentation" cellpadding="0" cellspacing="0" width="24" align="center">
                                            <tr>
                                                <td style="width:24px;height:24px;border:3px solid rgba(255,255,255,0.15);border-radius:50%;margin-top:-14px;"></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Brand eyebrow -->
                            <p style="margin:0 0 8px;font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:#FFB300;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                                FLIGHT: SZ-OTP-2026
                            </p>

                            <!-- Brand name -->
                            <h1 style="margin:0;font-size:36px;font-weight:900;color:#FFFFFF;letter-spacing:6px;text-transform:uppercase;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                                STAYZEN
                            </h1>

                            <!-- Subtext -->
                            <p style="margin:8px 0 0;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.5);font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                                BOOKING VERIFICATION
                            </p>
                        </td>
                    </tr>

                    <!-- ══════ BOARDING PASS TEAR LINE ══════ -->
                    <tr>
                        <td style="padding:0;">
                            <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <!-- Perforated circles -->
                                    <td style="background-color:#FAFAFA;height:2px;width:100%;font-size:0;line-height:0;">
                                        <div style="margin:0 auto;width:540px;height:2px;background:repeating-linear-gradient(to right,transparent,transparent 8px,#1A237E 8px,#1A237E 9px,transparent 9px,transparent 17px);"></div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- ══════ CONTENT BODY ══════ -->
                    <tr>
                        <td style="padding:36px 40px;">

                            <!-- Greeting -->
                            <p style="margin:0 0 8px;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#00838F;font-family:'Courier New',monospace;">
                                BOARDING PASS
                            </p>

                            <p style="margin:0 0 20px;font-size:22px;font-weight:900;color:#1A237E;line-height:1.2;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                                Hello, <%= username %>!
                            </p>

                            <p style="margin:0 0 20px;font-size:15px;line-height:1.7;color:#333333;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                                Welcome to <strong style="color:#1A237E;">StayZen</strong>. Your journey to premium stays starts here. Please use the following verification code to complete your registration:
                            </p>

                            <!-- ══════ OTP BOX — LUGGAGE TAG STYLE ══════ -->
                            <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td style="padding:10px 0;">
                                        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#FAFAFA;border:3px solid #1A237E;border-radius:8px;overflow:hidden;">
                                            <!-- OTP header strip -->
                                            <tr>
                                                <td style="background-color:#1A237E;padding:10px 20px;text-align:center;">
                                                    <p style="margin:0;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#FFB300;font-family:'Courier New',monospace;">
                                                        VERIFICATION CODE
                                                    </p>
                                                </td>
                                            </tr>
                                            <!-- OTP value -->
                                            <tr>
                                                <td style="padding:28px 20px;text-align:center;background-color:#FAFAFA;">
                                                    <p style="margin:0;font-size:48px;font-weight:900;letter-spacing:14px;color:#1A237E;font-family:'Courier New',monospace;line-height:1;">
                                                        <%= otp %>
                                                    </p>
                                                </td>
                                            </tr>
                                            <!-- Barcode decoration -->
                                            <tr>
                                                <td style="padding:0 40px 16px;text-align:center;">
                                                    <table role="presentation" cellpadding="0" cellspacing="0" align="center">
                                                        <tr>
                                                            <td style="width:3px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:4px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:2px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:3px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:4px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:2px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:3px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:4px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:2px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:3px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:4px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:2px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:3px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:4px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:2px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:3px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:1px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                            <td style="width:4px;height:18px;background-color:#1A237E;opacity:0.15;"></td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Expiry notice -->
                            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin-top:20px;">
                                <tr>
                                    <td style="background-color:#FFFBEB;border:2px solid #FFB300;border-radius:8px;padding:14px 20px;text-align:center;">
                                        <p style="margin:0;font-size:13px;color:#92400E;font-weight:600;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                                            ⏱ This code expires in <strong style="color:#1A237E;">10 minutes</strong>. If you did not request this, please ignore this email.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <!-- Sign-off -->
                            <p style="margin:28px 0 0;font-size:14px;color:#555555;line-height:1.6;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                                Best regards,<br>
                                <strong style="color:#1A237E;">The StayZen Team</strong>
                            </p>

                        </td>
                    </tr>

                    <!-- ══════ BOTTOM TEAR LINE ══════ -->
                    <tr>
                        <td style="padding:0;">
                            <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td style="background-color:#FAFAFA;height:2px;">
                                        <div style="margin:0 auto;width:540px;height:2px;background:repeating-linear-gradient(to right,transparent,transparent 8px,#1A237E 8px,#1A237E 9px,transparent 9px,transparent 17px);"></div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- ══════ FOOTER — LUGGAGE TAG STRIP ══════ -->
                    <tr>
                        <td style="background-color:#1A237E;padding:20px 40px;text-align:center;">
                            <p style="margin:0 0 6px;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#FFB300;font-family:'Courier New',monospace;">
                                © 2026 STAYZEN AIRWAYS
                            </p>
                            <p style="margin:0;font-size:10px;color:rgba(255,255,255,0.4);letter-spacing:1px;font-family:'Courier New',monospace;">
                                Premium stays and unique properties for the discerning traveler.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
